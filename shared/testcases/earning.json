{
  "formatVersion": 1,
  "description": "Earning sequences with cooldowns and period ceilings. Amounts are fixed, never random: EconomyWorld contains no randomness at all, for the legal reasons set out in the README.",
  "baseTimestampMs": 1700000000000,
  "scenarios": [
    {
      "id": "cooldown-blocks-then-releases",
      "description": "A payout, a blocked repeat inside the cooldown, then a payout once it expires.",
      "ruleKey": "message",
      "initialBalance": 0,
      "steps": [
        {
          "offsetMs": 0,
          "expected": {
            "outcome": "EARNED",
            "amount": 10,
            "grossAmount": 10,
            "previousBalance": 0,
            "newBalance": 10,
            "cooldownRemainingMs": 60000,
            "periodRemaining": 90,
            "booked": true
          }
        },
        {
          "offsetMs": 30000,
          "expected": {
            "outcome": "COOLDOWN",
            "amount": 0,
            "grossAmount": 10,
            "previousBalance": 10,
            "newBalance": 10,
            "cooldownRemainingMs": 30000,
            "periodRemaining": 90,
            "booked": false
          }
        },
        {
          "offsetMs": 60000,
          "expected": {
            "outcome": "EARNED",
            "amount": 10,
            "grossAmount": 10,
            "previousBalance": 10,
            "newBalance": 20,
            "cooldownRemainingMs": 60000,
            "periodRemaining": 80,
            "booked": true
          }
        }
      ],
      "finalBalance": 20
    },
