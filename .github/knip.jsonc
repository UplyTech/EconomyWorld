// knip reports what nobody imports. For a library that needs explaining: the
// entry point is by definition imported by nobody inside the repository, only
// by callers outside it. That is why it is listed as an entry and not treated
// as a finding.
//
// JSONC rather than JSON, and comments rather than a "//" key: knip validates
// its config strictly and rejects unknown keys, so the note that used to live
// in a "//" array made the check fail before it ran.
{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["src/index.ts", "examples/*.ts", "scripts/*.mjs"],
  "project": ["src/**/*.ts", "tests/**/*.ts"],
  "ignoreDependencies": ["@vitest/coverage-v8"],
  "ignoreExportsUsedInFile": true
}
