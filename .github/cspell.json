    "webhooks",
    "xorshift",
    "yamllint",
    "zizmor"
  ],
  "ignorePaths": [
    "node_modules/**",
    "**/node_modules/**",
    ".venv/**",
    "**/.venv/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.lock",
    "**/package-lock.json",
    "shared/testcases/**",
    "shared/vectors/**",
    "shared/registry/**",
    "**/*.min.*",
    "**/.git/**",
    "**/*.pyc"
  ],
  "ignoreRegExpList": [
    "/[0-9a-fA-F]{7,}/g",
    "/https?:\\/\\/[^\\s)]+/g",
    "/`[^`]*`/g",
    "/\\b[a-z]+[A-Z][a-zA-Z]*\\b/g"
  ],
  "dictionaries": [
    "typescript",
    "node",
    "python",
    "softwareTerms",
    "en_GB",
    "en_US"
  ]
}
