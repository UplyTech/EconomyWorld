{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-GB,en",
  "//": [
    "Not here to correct prose. The point is the identifier that was",
    "misspelt once and has been called that ever since - a check finds",
    "that, a read-through never does."
  ],
  "words": [
    "actionlint",
    "addopts",
    "aiomysql",
    "aiosqlite",
    "alembic",
