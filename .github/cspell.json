    "rankmode",
    "respx",
    "roundings",
    "ruff",
    "runtimes",
    "sarif",
    "sawstats",
    "sbom",
    "scorecard",
    "semver",
    "shellcheck",
    "snake",
    "stdlib",
    "teampromanager",
    "tenant",
    "tenants",
    "testpaths",
    "tomllib",
    "tsup",
