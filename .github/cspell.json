    "cspell",
    "dataclass",
    "dataclasses",
    "denormalised",
    "dependabot",
    "dotenv",
    "economyworld",
    "esbuild",
    "excinfo",
    "fastapi",
    "fingerprinting",
    "flashtrix",
    "freezegun",
    "gamestatsfetcher",
    "ghcr",
    "gini",
    "gitleaks",
    "hatchling",
    "Hauke",
    "hypothesis",
    "idempotent",
    "instalment",
    "instalments",
    "kebab",
    "knip",
    "lcov",
    "leaderboard",
    "leaderboards",
    "levelled",
