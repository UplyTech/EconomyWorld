{
  "name": "@uplytech/economyworld",
  "version": "2.0.0",
  "description": "Balances, double-entry bookings, inventories, shops and trades for community bots and forums. Pure calculation: no storage, no platform binding, integer amounts only. Play money — no real currency, no payouts, no random payouts.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "examples": "vite-node examples/basic.ts && vite-node examples/discord-bot-integration.ts && vite-node examples/financial-system.ts",
    "lint": "eslint src tests examples",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "economy",
    "currency",
    "balance",
    "ledger",
    "double-entry",
    "inventory",
    "shop",
    "trading",
    "virtual-currency",
    "discord-bot",
    "community",
    "uplytech",
    "economyworld"
  ],
  "author": "UplyTech <dev@uplytech.de>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UplyTech/EconomyWorld.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/UplyTech/EconomyWorld/issues"
  },
  "homepage": "https://github.com/UplyTech/EconomyWorld#readme",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "tsup": "^8.3.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
